{
    "compilerOptions": {
        "target": "ESNext", // 编译目标的 ECMAScript 版本
        "jsx": "preserve", // 保留 JSX 以供后续转换
        "jsxFactory": "h", // JSX 工厂函数
        "jsxFragmentFactory": "Fragment",
        "jsxImportSource": "vue", // JSX 导入来源
        "lib": [ // 编译需要包含的 API
            "ESNext",
            "DOM",
            "DOM.Iterable"
        ],
        "useDefineForClassFields": true, // 使用 Object.defineProperty 定义类字段
        "experimentalDecorators": true, // 启用装饰器
        "baseUrl": ".", // 非相对模块导入的基准目录
        "module": "ESNext", // 生成的模块系统代码
        "moduleResolution": "Node", // 模块解析策略，兼容 vite
        "paths": { // 路径映射，与 vite 配置对应
            "~/*": ["./"],
            "@/*": ["./src/*"],
            "#/*": ["./types/*"]
        },
        "resolveJsonModule": true, // 允许导入 JSON 模块
        "types": [ // 需要包含的类型声明文件
            "node",
            "vite/client",
            "element-plus/global"
        ],
        "strict": true, // 启用所有严格类型检查选项
        "noImplicitThis": true, // 禁止 this 有隐含的 any 类型
        "noUnusedLocals": false, // 关闭未使用局部变量的检查
        "noUnusedParameters": false, // 关闭未使用参数的检查
        "importHelpers": true, // 从 tslib 导入辅助工具函数
        "noEmit": true, // 不输出文件
        "sourceMap": true, // 生成源映射文件
        "allowSyntheticDefaultImports": true, // 允许从没有默认导出的模块中默认导入
        "esModuleInterop": true, // 启用 ES 模块互操作性
        "forceConsistentCasingInFileNames": true, // 强制文件名大小写一致
        "isolatedModules": true, // 确保每个文件都可以安全地独立转译
        "skipLibCheck": true // 跳过声明文件的类型检查
    },
    "include": [ // 需要编译的文件
        "src/**/*.ts",
        "src/**/*.d.ts",
        "src/**/*.tsx",
        "src/**/*.vue",
        "types/**/*.d.ts"
    ],
    "exclude": [ // 排除的文件
        "node_modules",
        "dist",
        "**/*.js",
        ".eslintrc-auto-import.json",
        "vite"
    ]
}
