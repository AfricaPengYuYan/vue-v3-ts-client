# ========== 基础配置 ==========
# 生产环境公共基础路径
VITE_PUBLIC_PATH = /

# ========== 路由配置 ==========
# 路由模式配置（同开发环境配置）
VITE_ROUTER_HISTORY = h5

# ========== 代理配置 ==========
# 生产环境跨域代理配置
VITE_PROXY = [
    ["/basic-prod", "http://localhost:3000"],
    ["/basic-prod-upload", "http://localhost:3300/upload"]
]

# ========== 构建优化配置 ==========
# 是否启用图片压缩
VITE_USE_IMAGEMIN = false

# 是否启用代码压缩
VITE_USE_COMPRESS = true

# 压缩算法类型
# none: 不压缩
# gzip: 使用gzip压缩
# brotli: 使用brotli压缩
# both: 同时使用gzip和brotli压缩
# gzip-clear: 使用gzip压缩并删除源文件
# brotli-clear: 使用brotli压缩并删除源文件
# both-clear: 同时使用两种压缩并删除源文件
VITE_COMPRESSION = none

# 使用压缩时是否删除源文件
VITE_COMPRESS_DELETE_ORIGIN_FILE = false

# 是否启用兼容性构建（支持旧版浏览器）
VITE_LEGACY = true

# 是否启用CDN加载依赖
# true: 使用CDN加载
# false: 使用本地依赖
VITE_CDN = true