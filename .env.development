# ========== 基础配置 ==========
# 开发环境公共基础路径
VITE_PUBLIC_PATH = /

# ========== 路由配置 ==========
# 路由模式配置
# h5: HTML5 History模式
# hash: Hash模式
# h5,base参数: HTML5模式带base参数
# hash,base参数: Hash模式带base参数
VITE_ROUTER_HISTORY = h5

# ========== 代理配置 ==========
# 跨域代理配置，可配置多个代理
# 格式: [路径前缀, 代理目标地址]
VITE_PROXY = [
    ["/basic-api", "http://172.16.200.225:8081/mes-api"],
    ["/upload", "http://localhost:3300/upload"]
]
